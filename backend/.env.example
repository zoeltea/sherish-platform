# Environment Variables Template for Sherish Platform Backend

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://sherish:sherish_secret_password_2026@localhost:5434/sherish_db?schema=public

